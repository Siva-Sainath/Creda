{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creda canonical evidence record",
  "type": "object",
  "required": [
    "evidence_id",
    "record_type",
    "source_id",
    "source_url",
    "evidence_tier",
    "content_hash",
    "label",
    "label_provenance",
    "label_confidence",
    "verification_status",
    "lifecycle_status",
    "processing_version"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "record_type": {
      "enum": [
        "job_posting",
        "offer_message",
        "employer_policy",
        "official_vacancy",
        "government_advisory",
        "government_guidance",
        "government_report",
        "registry_record",
        "media_report",
        "community_report",
        "scam_pattern"
      ]
    },
    "source_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "canonical_url": {"type": ["string", "null"]},
    "source_domain": {"type": ["string", "null"]},
    "publisher": {"type": ["string", "null"]},
    "evidence_tier": {"enum": ["T1", "T2", "T3"]},
    "country": {"type": ["string", "null"]},
    "applicant_country": {"type": ["string", "null"]},
    "employment_country": {"type": ["string", "null"]},
    "remote_scope": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "employer_claimed": {"type": ["string", "null"]},
    "employer_canonical_domain": {"type": ["string", "null"]},
    "recruiter_name_claimed": {"type": ["string", "null"]},
    "recruiter_contact_channel": {"type": ["string", "null"]},
    "sender_domain": {"type": ["string", "null"]},
    "role_title": {"type": ["string", "null"]},
    "employment_type": {"type": ["string", "null"]},
    "salary_text": {"type": ["string", "null"]},
    "payment_requested": {"type": ["boolean", "null"]},
    "payment_amount": {"type": ["string", "null"]},
    "payment_currency": {"type": ["string", "null"]},
    "payment_method": {"type": ["string", "null"]},
    "requested_documents": {"type": ["string", "null"]},
    "urgency_claims": {"type": ["string", "null"]},
    "equipment_purchase_claim": {"type": ["boolean", "null"]},
    "visa_or_relocation_claim": {"type": ["boolean", "null"]},
    "extracted_claims": {"type": ["string", "null"]},
    "scam_pattern_tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "original_text": {"type": ["string", "null"]},
    "normalized_text": {"type": ["string", "null"]},
    "label": {"enum": ["legitimate", "confirmed_scam", "suspicious_pattern", "unverified"]},
    "label_provenance": {"type": ["string", "null"]},
    "label_confidence": {"enum": ["low", "medium", "high"]},
    "human_review_status": {"type": ["string", "null"]},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "near_duplicate_group": {"type": ["string", "null"]},
    "campaign_group": {"type": ["string", "null"]},
    "derived_from_emscad": {"type": ["boolean", "null"]},
    "published_at": {"type": ["string", "null"]},
    "observed_at": {"type": ["string", "null"]},
    "last_verified_at": {"type": ["string", "null"]},
    "next_verification_at": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"]},
    "verification_status": {
      "enum": ["verified_unchanged", "verified_changed", "source_unavailable", "awaiting_review", "not_reverified"]
    },
    "lifecycle_status": {
      "enum": ["active", "stale", "superseded", "unavailable", "quarantined", "rejected"]
    },
    "supersedes_evidence_id": {"type": ["string", "null"]},
    "raw_s3_uri": {"type": ["string", "null"]},
    "curated_s3_uri": {"type": ["string", "null"]},
    "pii_redaction_status": {"type": ["string", "null"]},
    "processing_version": {"type": "string"},
    "evaluation_eligible": {"type": ["boolean", "null"]},
    "evaluation_partition": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
